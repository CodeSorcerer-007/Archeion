{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArcheionProtocolVersion",
  "type": "object",
  "properties": {
    "major": { "type": "integer", "minimum": 1 },
    "minor": { "type": "integer", "minimum": 0 },
    "patch": { "type": "integer", "minimum": 0 },
    "supportedVersions": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["major", "minor", "patch", "supportedVersions"]
}
